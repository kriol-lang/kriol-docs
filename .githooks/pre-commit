#!/bin/sh
# Signs the docs for sourced.net when a commit changes them, and adds the
# signed files (site/public/.well-known/sourced/) to the commit.
# Enable once per clone:   git config core.hooksPath .githooks
# Skip for one commit:     SOURCED_SKIP_SIGN=1 git commit …
set -eu

[ "${SOURCED_SKIP_SIGN:-}" = "1" ] && exit 0

changed=$(git diff --cached --name-only --diff-filter=ACMRD -- site/src site/public site/astro.config.mjs \
	| grep -v '^site/public/.well-known/sourced/' || true)
[ -z "$changed" ] && exit 0

if ! command -v sourced-publisher >/dev/null 2>&1; then
	echo "pre-commit: sourced-publisher isn't on the PATH; the docs were not signed." >&2
	exit 0
fi
if [ ! -d site/.sourced/keys ]; then
	echo "pre-commit: no signing key in site/.sourced/keys; the docs were not signed." >&2
	exit 0
fi

echo "pre-commit: signing the docs (npm run sign)…" >&2
(cd site && npm run --silent sign) >&2
git add site/public/.well-known/sourced
