{
  "name": "Kriol",
  "scopeName": "source.kriol",
  "fileTypes": ["kr", "kriol"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#identifiers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kriol",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kriol",
          "begin": "f?\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.kriol", "match": "\\\\." },
            { "name": "meta.interpolation.kriol", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        },
        {
          "name": "string.quoted.single.kriol",
          "begin": "f?'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.kriol", "match": "\\\\." },
            { "name": "meta.interpolation.kriol", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kriol",
          "match": "\\b(si|sinon|pa|nkuantu|para|kontinua|divolvi|sai)\\b"
        },
        {
          "name": "keyword.other.kriol",
          "match": "\\b(fn|inisiu|dipoz|inpristan|konfirma|impl|molda|toma)\\b"
        },
        {
          "name": "support.function.kriol",
          "match": "\\b(mostra|mostran)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.kriol",
          "match": "\\b(nter|num|textu|bool|Ami)\\b"
        },
        {
          "name": "constant.language.boolean.kriol",
          "match": "\\b(sin|nau)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.float.kriol",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.kriol",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.kriol",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.kriol",
          "match": "\\+\\=|\\-\\=|\\*\\=|\\/\\=|==|!=|<=|>=|&&|\\|\\||[+\\-*/<>=!]"
        }
      ]
    }
  }
}
