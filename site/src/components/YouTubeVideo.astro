---
// Shows a local poster, and loads YouTube's player only when asked to, so that
// the page makes no requests to YouTube (and sets no cookies) before. The same
// as on kriol.dev.
import poster from '../assets/video-kriol.webp';

interface Props {
	id: string;
	title: string;
	duration: string;
}

const { id, title, duration } = Astro.props;
---

<figure class="kriol-video not-content">
	<kriol-video class="kriol-video-frame" data-id={id} data-title={title}>
		<button type="button" class="kriol-video-poster">
			<img src={poster.src} width={poster.width} height={poster.height} alt="" loading="lazy" />
			<span class="kriol-video-play" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5.5v13l10.5-6.5L8 5.5Z"></path></svg>
			</span>
			<span class="sr-only">Ver o vídeo «{title}»</span>
			<span class="kriol-video-duration" aria-hidden="true">{duration}</span>
		</button>
	</kriol-video>
	<figcaption>
		<span>{title} · {duration}</span>
		<a href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noreferrer">Ver no YouTube</a>
	</figcaption>
</figure>

<script>
	class KriolVideo extends HTMLElement {
		connectedCallback() {
			this.querySelector('button')?.addEventListener('click', () => this.play(), { once: true });
		}

		play() {
			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${this.dataset.id}?autoplay=1&rel=0`;
			iframe.title = this.dataset.title ?? '';
			iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			iframe.allowFullscreen = true;
			iframe.referrerPolicy = 'strict-origin-when-cross-origin';
			this.replaceChildren(iframe);
			iframe.focus();
		}
	}

	customElements.define('kriol-video', KriolVideo);
</script>

<style>
	.kriol-video {
		margin-block: 1.5rem;
	}

	.kriol-video-frame {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--kriol-hand, 0.5rem);
		background: var(--sl-color-black);
	}

	.kriol-video-frame :global(iframe),
	.kriol-video-poster,
	.kriol-video-poster img {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.kriol-video-poster {
		position: relative;
		padding: 0;
		background: none;
		cursor: pointer;
	}

	.kriol-video-poster img {
		object-fit: cover;
		transition: filter 0.2s;
	}

	.kriol-video-poster:hover img,
	.kriol-video-poster:focus-visible img {
		filter: brightness(0.85);
	}

	.kriol-video-play {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		place-items: center;
		width: 4.25rem;
		height: 4.25rem;
		border-radius: 50%;
		color: #ffffff;
		background: var(--sl-color-accent);
		transform: translate(-50%, -50%);
	}

	.kriol-video-play svg {
		margin-left: 3px;
		fill: currentColor;
	}

	.kriol-video-duration {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		padding: 0.1rem 0.5rem;
		border-radius: 0.375rem;
		color: #ffffff;
		background: rgb(10 12 14 / 75%);
		font: 600 var(--sl-text-xs) var(--__sl-font-mono);
	}

	figcaption {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin-top: 0.75rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	figcaption a {
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}

	@media (prefers-reduced-motion: reduce) {
		.kriol-video-poster img {
			transition: none;
		}
	}
</style>
